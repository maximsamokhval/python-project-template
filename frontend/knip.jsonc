{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.{js,jsx,ts,tsx}"],
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": [
      "tests/{unit,component,browser}/**/*.{test,browser.test}.{ts,tsx}",
    ],
  },
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["tests/e2e/**/*.spec.ts"],
  },
}
